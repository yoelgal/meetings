diff -ru a/Sources/MarkdownEngine/TextView/Coordinator/NativeTextViewCoordinator+TextDelegate.swift b/Sources/MarkdownEngine/TextView/Coordinator/NativeTextViewCoordinator+TextDelegate.swift
--- a/Sources/MarkdownEngine/TextView/Coordinator/NativeTextViewCoordinator+TextDelegate.swift	2026-08-15 11:26:49
+++ b/Sources/MarkdownEngine/TextView/Coordinator/NativeTextViewCoordinator+TextDelegate.swift	2026-08-15 11:27:23
@@ -694,6 +694,15 @@
         // Skip during a pending edit — viewRect is stale until textDidChange's restyle runs; otherwise the overlay flashes to the old Y before settling.
         if !shouldSkipSelectionRestyle {
             updateCodeBlockSelection(textView: tv, parsed: parsed)
+            // Same freshness rule, same reason: a floating toolbar anchored off a
+            // stale rect flashes to the previous line before settling. Reported
+            // here rather than at the top of this method so the rect is measured
+            // against the layout the restyle above has already settled.
+            if let onSelectionRectChange {
+                let selRange = tv.selectedRange()
+                let rect = tv.viewRect(forCharacterRange: selRange, using: layoutBridge)
+                DispatchQueue.main.async { onSelectionRectChange(rect, selRange) }
+            }
         }
     }
 
